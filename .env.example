# [화성시 뉴스 알리미 환경 설정]
# 이 파일을 복사하여 .env 로 이름을 변경한 후 키 값을 입력하세요.
# 키를 입력하지 않아도 실시간 공개 뉴스 피드를 통해 정상 동작합니다.

# 1. 네이버 뉴스 검색 API (둘 중 보유한 서비스의 키를 입력)
# - 네이버 개발자센터 (https://developers.naver.com): Client ID / Client Secret
# - 또는 네이버 클라우드 플랫폼 (https://www.ncloud.com): API Gateway Key ID / Key
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 2. Google Gemini API 키 (AI 기반 3줄 요약용)
# - Google AI Studio (https://aistudio.google.com)에서 발급 가능
GEMINI_API_KEY=

# 3. 텔레그램 봇 알림 설정 (신규 뉴스 자동 발송용)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
